# Copy this file to .env and fill in your key. .env is git-ignored — never commit your key.
OPENROUTER_API_KEY=

# Any OpenRouter model id. Check the exact id at https://openrouter.ai/models (Settings > "Check model" in the app).
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# Optional: a different model for deep dives and chat (defaults to OPENROUTER_MODEL).
OPENROUTER_RESEARCH_MODEL=

PORT=3000
# How often to pull new articles, in minutes (0 = only on startup / when you press Refresh).
REFRESH_MINUTES=30
# How long articles are kept for grouping.
ARTICLE_MAX_AGE_HOURS=72
