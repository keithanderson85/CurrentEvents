# Copy this file to .env and fill in your key. .env is git-ignored — never commit your key.
OPENROUTER_API_KEY=

# Any OpenRouter model id. Check the exact id at https://openrouter.ai/models (Settings > "Check model" in the app).
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# Optional: a different model for deep dives and chat (defaults to OPENROUTER_MODEL).
OPENROUTER_RESEARCH_MODEL=

# "Thinking" models can burn their whole answer budget thinking and reply with nothing.
# off (default) turns thinking off for speed and reliability; low | medium | high turn it on; default = model's own setting.
OPENROUTER_REASONING=off

PORT=3000
# Docker only: the port on your computer that maps to the app (docker compose).
HOST_PORT=3000
# How often to pull new articles, in minutes (0 = only on startup / when you press Refresh).
REFRESH_MINUTES=30
# How long articles are kept for grouping.
ARTICLE_MAX_AGE_HOURS=72

# Optional: free key from openalex.org for a larger daily research-paper search allowance.
# OPENALEX_API_KEY=

# Automatic reality check after each refresh (one AI call per story). on | off
# AUTO_CHECK=on
# AUTO_CHECK_MAX=12

# Optional but recommended: full web search, so deep dives and chat can reach state and local
# government pages, court documents and statutes. Set ONE of these (both have a free tier):
#   Tavily: https://tavily.com   Brave: https://brave.com/search/api
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ---- Accounts ----
# The first account created becomes the admin. On a public site, set SIGNUP_CODE before the
# first start so only someone with the code can create that first account. Afterwards the
# admin can change the invite code in Settings.
# SIGNUP_CODE=choose-something-only-you-know
# Public address of the site, used in password reset links.
# APP_URL=https://news.example.com
# Email for password resets (optional). Gmail: host smtp.gmail.com, port 587, your address,
# and an "app password" (not your normal password). Without these, the admin can create
# reset links in Settings instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# SMTP_FROM=OpenFrame News <you@gmail.com>
